#!/bin/bash
#PBS -N jacobi_wait_diag
#PBS -q auto_free
#PBS -l select=1:ncpus=12:mpiprocs=12:ompthreads=1:mem=4gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -k oed
#PBS -S /bin/bash
set -euo pipefail
: "${PBS_JOBID:?Submit with qsub}"
cd "$PBS_O_WORKDIR"
run_dir="$PBS_O_WORKDIR/results/Vanda_mpi_wait_${PBS_JOBID}"
mkdir -p "$PBS_O_WORKDIR/results"
mkdir "$run_dir"
exec > >(tee "$run_dir/run.log") 2>&1
trap 'status=$?; printf "JOB_EXIT_STATUS=%s\n" "$status"; exit "$status"' EXIT
if [ -f vanda_modules.sh ]; then source ./vanda_modules.sh; else source ./vanda_modules.example.sh; fi
{
    date -Is
    hostname
    printf 'EXPERIMENT=wait-placement-v1\nK=1000\nTOL=0\nINSTRUMENTATION=none\n'
    g++ --version
    mpicxx --showme
    mpirun --version
    python3 --version
    module list
} > "$run_dir/metadata.txt" 2>&1
cat "$run_dir/metadata.txt"
python3 -c 'import os; print("\n".join(k+"="+v for k,v in sorted(os.environ.items()) if k in ("PATH","LD_LIBRARY_PATH","LOADEDMODULES","MODULEPATH") or k.startswith(("PBS_","OMP_","OMPI_"))))' > "$run_dir/environment.txt"
lscpu > "$run_dir/lscpu.txt"
qstat -f "$PBS_JOBID" > "$run_dir/qstat_at_start.txt"
cp /proc/self/status "$run_dir/process_status.txt"
cp "$PBS_NODEFILE" "$run_dir/pbs_nodefile.txt"
pin_cpus=$(python3 -c 'import os; c=sorted(os.sched_getaffinity(0)); assert len(c)==12, "Expected 12 allocated CPUs"; print(",".join(map(str,c)))')
printf 'PIN_CPUS=%s\n' "$pin_cpus" | tee "$run_dir/pin_cpus.txt"
mkdir "$run_dir/sources" "$run_dir/bin"
cp jacobi_mpi.cpp jacobi_mpi_wait_diagnostic.cpp mpi_wait_diagnostic.py mpi_wait_reference.json \
    pin_cpu.py benchmark_parallel.py vanda_mpi_wait_diagnostic.pbs vanda_modules.example.sh "$run_dir/sources/"
if [ -f vanda_modules.sh ]; then cp vanda_modules.sh "$run_dir/sources/"; fi
sha256sum "$run_dir"/sources/* > "$run_dir/source_sha256.txt"
set -x
mpicxx -std=c++17 -O2 -Wall -Wextra -Wpedantic "$run_dir/sources/jacobi_mpi.cpp" -o "$run_dir/bin/jacobi_mpi"
mpicxx -std=c++17 -O2 -Wall -Wextra -Wpedantic "$run_dir/sources/jacobi_mpi_wait_diagnostic.cpp" -o "$run_dir/bin/jacobi_mpi_wait_diagnostic"
set +x
sha256sum "$run_dir"/bin/* > "$run_dir/executable_sha256.txt"
export OMP_NUM_THREADS=1 OMP_DYNAMIC=FALSE
python3 "$run_dir/sources/mpi_wait_diagnostic.py" run --build-dir "$run_dir/bin" \
    --out-dir "$run_dir/diagnostic" --pin-cpus "$pin_cpus"
printf 'RUN_STATUS=PASSED\n'
